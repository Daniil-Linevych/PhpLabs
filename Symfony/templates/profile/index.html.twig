{% extends 'base.html.twig' %}

{% block title %}Your Profile{% endblock %}

{% block body %}
<div class="container">
    <h1>Welcome, {{ user.fullName }}</h1>
    <p>Your roles: {{ user.roles|join(', ') }}</p>

    <a href="{{ path('app_logout') }}" class="btn btn-danger">Logout</a>

    {% if not is_granted('ROLE_ADMIN') and not is_granted('ROLE_WORKER') %}
    <div class="container mt-4">
    <div class="row g-3">
        <div class="col-md-6">
            <h3 class="mb-4">Buyed tickets:</h3>
            <ul class="list-group">
                {% for ticket in tickets %}
                <div class="container">
                    <div class="row">
                        <a href="{{ path('tickets_show', {'id': ticket.id}) }}" class="text-decoration-none col-md-10">
                            <li class="list-group-item">Ticket {{ ticket.id }}</li>
                        </a>
                        <a href="{{ path('tickets_sell', {'id': ticket.id}) }}" class="btn btn-danger mt-1 col-md-2">Sell</a>
                    </div>
                </div>
                {% endfor %}
            </ul>
        </div>
    </div>
    </div>
    {% endif %}
</div>
{% endblock %}
