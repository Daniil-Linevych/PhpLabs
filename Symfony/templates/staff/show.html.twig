{% extends 'base.html.twig' %}

{% block title %}Staff member | {{ staff_member.fullName }}{% endblock %}

{% block body %}
    <h1>Staff member: {{ staff_member.fullName }}</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ staff_member.id }}</td>
            </tr>
            <tr>
                <th>Full Name</th>
                <td>{{ staff_member.fullName }}</td>
            </tr>
            <tr>
                <th>Position</th>
                <td>{{ staff_member.position }}</td>
            </tr>
            <tr>
                <th>Hire Date</th>
                <td>{{ staff_member.hireDate.format('Y-m-d') }}</td>
            </tr>
            <tr>
                <th>Phone</th>
                <td>{{ staff_member.phone }}</td>
            </tr>
            <tr>
                <th>Email</th>
                <td>{{ staff_member.user ? staff_member.user.email : 'N/A' }}</td>
            </tr>
            <tr>
                <th>Salary</th>
                <td>{{ staff_member.salary }}</td>
            </tr>
            <tr>
                <th>Exhibitions</th>
                <td>{{ staff_member.getExhibitionsString() }}</td>
            </tr>
        </tbody>
    </table>

    
    <div class="buttons-container">     
    <a href="{{ path('staff_index') }}" class="btn btn-outline-secondary text-decoration-none">Back to list</a>   
    <a href="{{ path('staff_update', {'id': staff_member.id}) }}" class="btn btn-warning text-decoration-none" >Edit</a>
        <form method="post" action="{{ path('staff_delete', {'id': staff_member.id}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ staff_member.id) }}">
            <button class="btn btn-danger">Delete</button>
        </form>
    </div>  
{% endblock %}