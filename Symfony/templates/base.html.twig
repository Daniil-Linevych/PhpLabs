<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Museum Management{% endblock %}</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('css/app.css') }}">
    
    {% block stylesheets %}{% endblock %}
</head>
<body>
    <nav class="navbar-dark bg-dark mb-4">
        <div class="container">
            <div class="navbar-nav flex-row">
                <a class="nav-link p-3 " href="{{ path('exhibits_index') }}"><p class="fs-5 fw-normal">Exhibits</p></a>
                <a class="nav-link p-3" href="{{ path('exhibitions_index') }}"><p class="fs-5 fw-normal">Exhibitions</p></a>
                <a class="nav-link p-3" href="{{ path('staff_index') }}"><p class="fs-5 fw-normal">Staff</p></a>
                <a class="nav-link p-3" href="{{ path('visitors_index') }}"><p class="fs-5 fw-normal">Visitors</p></a>
                <a class="nav-link p-3" href="{{ path('tickets_index') }}"><p class="fs-5 fw-normal">Tickets</p></a>
            </div>
        </div>
    </nav>

    <div class="container">
        {% include 'partials/alerts.html.twig' %}
        {% block body %}{% endblock %}
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    {% block javascripts %}{% endblock %}
</body>
</html>