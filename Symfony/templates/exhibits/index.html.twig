{% extends 'base.html.twig' %}

{% block title %}Exhibits{% endblock %}

{% block body %}
    <h1>Exhibits</h1>

    <a href="{{ path('exhibits_create') }}" class="btn btn-primary mb-3">Create New Exhibit</a>

    <form method="get">
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <input type="text" name="name" class="form-control"
                    value="{{ app.request.query.get('name') }}" 
                    placeholder="Filter by name">
            </div>
            <div class="col-md-3">
                <input type="text" name="author" class="form-control"
                    value="{{ app.request.query.get('author') }}" 
                    placeholder="Filter by author">
            </div>
            <div class="col-md-3">
                <input type="text" name="creationYear" class="form-control"
                    value="{{ app.request.query.get('creationYear') }}" 
                    placeholder="Filter by creation year">
            </div>
            <div class="col-md-3">
                <input type="text" name="exhibition" class="form-control"
                    value="{{ app.request.query.get('exhibition') }}" 
                    placeholder="Filter by exhibition">
            </div>
        </div>
        
        <button type="submit" class="btn btn-info mt-2">Filter</button>
        <a href="{{ path('exhibits_index') }}" class="btn btn-outline-secondary mt-2 ms-2">Reset</a>
    </form>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Author</th>
                <th>Creation Year</th>
                <th>Exhibition</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for exhibit in pager %}
            <tr>
                <td>{{ exhibit.id }}</td>
                <td>{{ exhibit.name }}</td>
                <td>{{ exhibit.author }}</td>
                <td>{{ exhibit.creationYear }}</td>
                <td>{{ exhibit.exhibition ? exhibit.exhibition.name : 'Not assigned!' }}</td>
                <td class="actions-column">
                    <a href="{{ path('exhibits_show', {'id': exhibit.id}) }}" class="btn btn-sm btn-info">
                        <i class="bi bi-eye"></i> Show
                    </a>
                    <a href="{{ path('exhibits_update', {'id': exhibit.id}) }}" class="btn btn-sm btn-warning">
                        <i class="bi bi-pencil"></i> Edit
                    </a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">No exhibits found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
     <div class="mt-4">
        <twig:pagination :pager="pager"/>
    </div>

{% endblock %}