{% extends 'base.html.twig' %}

{% block title %}Visitors | {{ visitor.fullName }}{% endblock %}

{% block body %}

    <h1>Visitor: {{ visitor.fullName }}</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ visitor.id }}</td>
            </tr>
            <tr>
                <th>Full Name</th>
                <td>{{ visitor.fullName}}</td>
            </tr>
            <tr>
                <th>Email</th>
                <td>{{ visitor.email }}</td>
            </tr>
            <tr>
                <th>Phone</th>
                <td>{{ visitor.phone }}</td>
            </tr>
            <tr>
                <th>Registration Date</th>
                <td>{{ visitor.registrationDate.format('Y-m-d H:i:s') }}</td>
            </tr>
        </tbody>
    </table>

    
    <div class="buttons-container">     
    <a href="{{ path('visitors_index') }}" class="btn btn-outline-secondary text-decoration-none">Back to list</a>   
    <a href="{{ path('visitors_update', {'id': visitor.id}) }}" class="btn btn-warning text-decoration-none" >Edit</a>
        <form method="post" action="{{ path('visitors_delete', {'id': visitor.id}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ visitor.id) }}">
            <button class="btn btn-danger">Delete</button>
        </form>
    </div>  

    <div class="container mt-4">
    <div class="row g-3">
        <div class="col-md-6">
            <h3 class="mb-4">Buyed tickets:</h3>
            <ul class="list-group">
                {% for ticket in tickets %}
                <div class="container">
                    <div class="row">
                        <a href="{{ path('tickets_show', {'id': ticket.id}) }}" class="text-decoration-none col-md-10">
                            <li class="list-group-item">Ticket {{ ticket.id }}</li>
                        </a>
                        <a href="{{ path('tickets_sell', {'id': ticket.id}) }}" class="btn btn-danger mt-1 col-md-2">Sell</a>
                    </div>
                </div>
                {% endfor %}
            </ul>
        </div>
    </div>
    </div>

{% endblock %}