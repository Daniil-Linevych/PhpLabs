{% extends 'base.html.twig' %}

{% block title %}Exhibitions{% endblock %}

{% block body %}
    <h1>Exhibitions</h1>

    <a href="{{ path('exhibitions_create') }}" class="btn btn-primary mb-3">Create New Exhibition</a>

    <form method="get">
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <input type="text" name="name" class="form-control"
                    value="{{ app.request.query.get('name') }}" 
                    placeholder="Filter by name">
            </div>
            <div class="col-md-3">
                <input type="text" name="start_date" class="form-control"
                    value="{{ app.request.query.get('start_date') }}" 
                    placeholder="Filter by start date">
            </div>
            <div class="col-md-3">
                <input type="text" name="end_date" class="form-control"
                    value="{{ app.request.query.get('end_date') }}" 
                    placeholder="Filter by end date">
            </div>
            <div class="col-md-3">
                <input type="text" name="staff" class="form-control"
                    value="{{ app.request.query.get('staff') }}" 
                    placeholder="Filter by staff">
            </div>
        </div>
        
        <button type="submit" class="btn btn-info mt-2">Filter</button>
        <a href="{{ path('exhibitions_index') }}" class="btn btn-outline-secondary mt-2 ms-2">Reset</a>
    </form>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Start date</th>
                <th>End date</th>
                <th>Staff Members</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for exhibition in pager %}
            <tr>
                <td>{{ exhibition.id }}</td>
                <td>{{ exhibition.name }}</td>
                <td>{{ exhibition.startDate.format('Y-m-d') }}</td>
                <td>{{ exhibition.endDate.format('Y-m-d') }}</td>
                <td>{% if exhibition.staffMembers is not empty %}
                    {{ exhibition.staffMembers|map(staff_member => attribute(staff_member, 'fullName'))|join(', ') }}
                    {% else %}
                        Nobody assigned!
                    {% endif %}
                </td>
                <td class="actions-column">
                    <a href="{{ path('exhibitions_show', {'id': exhibition.id}) }}" class="btn btn-sm btn-info">
                        <i class="bi bi-eye"></i> Show
                    </a>
                    <a href="{{ path('exhibitions_update', {'id': exhibition.id}) }}" class="btn btn-sm btn-warning">
                        <i class="bi bi-pencil"></i> Edit
                    </a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">No exhibitions found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    <div class="mt-4">
        <twig:pagination :pager="pager" :perPageOptions="[1, 2, 3]"/>
    </div>

{% endblock %}