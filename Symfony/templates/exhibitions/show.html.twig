{% extends 'base.html.twig' %}

{% block title %}Exhibitions | {{ exhibition.name }}{% endblock %}

{% block body %}

    <h1>Exhibition: {{ exhibition.name }}</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ exhibition.id }}</td>
            </tr>
            <tr>
                <th>Start Date</th>
                <td>{{ exhibition.startDate.format('l, F j, Y')}}</td>
            </tr>
            <tr>
                <th>End Date</th>
                <td>{{ exhibition.endDate.format('l, F j, Y') }}</td>
            </tr>
            <tr>
                <th>Staff Members</th>
                <td>{{ exhibition.getStaffMembersString() }}</td>
            </tr>
        </tbody>
    </table>

    
    <div class="buttons-container">     
    <a href="{{ path('exhibitions_index') }}" class="btn btn-outline-secondary text-decoration-none">Back to list</a>   
    <a href="{{ path('exhibitions_update', {'id': exhibition.id}) }}" class="btn btn-warning text-decoration-none" >Edit</a>
        <form method="post" action="{{ path('exhibitions_delete', {'id': exhibition.id}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ exhibition.id) }}">
            <button class="btn btn-danger">Delete</button>
        </form>
    </div>  

    <div class="container mt-4">
    <div class="row g-3">
        <div class="col-md-6">
            <h3 class="mb-4">Related exhibits:</h3>
            <table class="table">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Name</th>
                    </tr>
                </thead>
                <tbody>
                    {% for exhibit in exhibits %}
                        <tr>
                            <td>{{ exhibit.id }}</td>
                            <td><a href="{{ path('exhibits_show', {'id': exhibit.id}) }}" class="text-decoration-none text-dark">{{ exhibit.name }}</a></td>  
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        <div class="col-md-6">
            <h3 class="mb-4">Related Tickets:</h3>
            <ul class="list-group">
                {% for ticket in tickets %}
                    <a href="{{ path('tickets_show', {'id': ticket.id}) }}" class="text-decoration-none">
                        <li class="list-group-item">Ticket {{ ticket.id }}</li>
                    </a>
                {% endfor %}
            </ul>
        </div>
    </div>
    </div>

{% endblock %}